# ─────────────────────────────────────────────────────────────
# Urban Drip Backend — Environment Variables
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase / any PG host).
# Example: postgresql://user:password@host:5432/postgres?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# REQUIRED in production. Must be a long random string (>= 32 chars).
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=

# REQUIRED in production. Must be a long random string (>= 32 chars).
SECRET_KEY=

# Port the app listens on (default 8000).
PORT=8000

# Optional: comma-separated additional CORS origins (e.g. your prod domain).
# Example: ALLOWED_ORIGINS=https://my-store.com,https://admin.my-store.com
# ALLOWED_ORIGINS=
